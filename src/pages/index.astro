---
import Layout from "../layouts/Layout.astro";
import { topics } from "../data/topics";

const sorted = [...topics].sort((a, b) => a.order - b.order);
---

<Layout title="Guía del CEO">
  <section class="hero">
    <h1>Conocimiento técnico esencial para dirigir una empresa</h1>
    <p>
      No necesitas ser experto en cada rama del negocio, pero sí manejar lo suficiente
      para tomar decisiones informadas, hacer las preguntas correctas y detectar cuando
      algo no cuadra — delegando la ejecución a tu equipo especializado. Ocho ramas,
      resumidas como guía de referencia rápida.
    </p>
  </section>

  <section class="topic-grid">
    {
      sorted.map((topic) => (
        <a
          class="topic-card"
          href={`/${topic.slug}/`}
          style={`--card-color: ${topic.color}; --card-color-soft: ${topic.color}22;`}
        >
          <span class="icon">{topic.icon}</span>
          <div class="num">RAMA {String(topic.order).padStart(2, "0")}</div>
          <h3>{topic.title}</h3>
          <p>{topic.subtitle}</p>
        </a>
      ))
    }
  </section>
</Layout>
